# ─────────────────────────────────────────────────────────────────────────────
# Continuity Council — Environment Variables Reference
# Copy this file to backend/.env for local development.
# In production (Cloud Run) set these as Cloud Run environment variables /
# secrets — never bake them into the Docker image.
# ─────────────────────────────────────────────────────────────────────────────

# ── ClickHouse ────────────────────────────────────────────────────────────────
# REQUIRED — ClickHouse Cloud hostname (e.g. abc123.us-east-1.aws.clickhouse.cloud)
CLICKHOUSE_HOST=
# OPTIONAL — Native protocol port (default: 8443 for ClickHouse Cloud TLS)
CLICKHOUSE_PORT=8443
# REQUIRED — ClickHouse database name
CLICKHOUSE_DATABASE=continuity_council
# OPTIONAL — ClickHouse username (default: default)
CLICKHOUSE_USER=default
# REQUIRED — ClickHouse password
CLICKHOUSE_PASSWORD=
# OPTIONAL — Use TLS (default: true; set false only for local unsecured ClickHouse)
CLICKHOUSE_SECURE=true

# ── Gemini ────────────────────────────────────────────────────────────────────
# REQUIRED — Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OPTIONAL — Gemini model name for council agents (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# OPTIONAL — Gemini TTS model (default: gemini-2.5-flash-preview-tts)
TTS_MODEL=gemini-2.5-flash-preview-tts
# OPTIONAL — TTS voice name (default: Kore)
TTS_VOICE=Kore
# OPTIONAL — TTS generation timeout in seconds (default: 25.0)
TTS_TIMEOUT_SECONDS=25.0

# ── Backend server ────────────────────────────────────────────────────────────
# OPTIONAL — Port the backend listens on.
#            Cloud Run sets PORT automatically; default 8080 matches Cloud Run.
#            For local dev, dev.bat sets PORT=8000.
PORT=8080
# OPTIONAL — Comma-separated list of allowed CORS origins.
#            Set to your Cloud Run service URL after first deploy.
#            Example: https://continuity-council-abc123-uc.a.run.app
#            Falls back to localhost:3000 and localhost:8000 if not set.
ALLOWED_ORIGINS=
# OPTIONAL — Legacy alias for ALLOWED_ORIGINS (still accepted, prefer ALLOWED_ORIGINS)
# CORS_ORIGINS=http://localhost:3000
# OPTIONAL — Absolute or relative path to frontend build directory.
#            Set automatically by Dockerfile (../frontend/build).
#            Only needed if you run the backend outside Docker with a custom path.
FRONTEND_BUILD_DIR=../frontend/build
