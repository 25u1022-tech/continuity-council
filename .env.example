# Copy this file to backend/.env and replace the empty values with real credentials.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=continuity_council
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:3000
